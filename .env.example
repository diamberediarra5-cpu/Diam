# ─────────────────────────────────────────────────────────────
# Presupuéstalo — variables de entorno. Copia a .env y rellena.
# NUNCA subas .env a git. Los valores de abajo son ejemplos.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://usuario:password@localhost:5432/presupuestalo"

# URL pública de la app (sin barra final). En producción: https://tudominio.es
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Secreto de sesiones: genera uno con `openssl rand -base64 32`
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Datos legales y de contacto que aparecen en la web
NEXT_PUBLIC_SUPPORT_EMAIL="hola@tudominio.es"
NEXT_PUBLIC_LEGAL_OWNER="Nombre y apellidos o razón social"
NEXT_PUBLIC_LEGAL_TAX_ID="NIF"

# ── Emails (Resend). Sin clave: en desarrollo se imprimen en consola.
RESEND_API_KEY=""
EMAIL_FROM="Presupuéstalo <no-reply@tudominio.es>"
# Buzón donde llegan los mensajes del formulario de contacto (opcional)
CONTACT_INBOX=""

# ── Stripe (modo test: claves sk_test_ / whsec_ / price_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ID del precio mensual recurrente de 9,90 € del producto "Pro"
STRIPE_PRICE_PRO_MONTHLY=""

# ── IA
# AI_PROVIDER: "anthropic" | "mock" (solo desarrollo/tests) | vacío = desactivada.
# Si se deja vacío pero hay ANTHROPIC_API_KEY, se usa "anthropic".
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
# Modelo (por defecto claude-opus-5-5). Para abaratar puedes usar claude-haiku-4-5.
AI_MODEL=""

# Solo tests: desactiva el rate limit de login (NO usar en producción)
# AUTH_RATE_LIMIT="off"
